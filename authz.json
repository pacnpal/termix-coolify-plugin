{
  "$schema": "https://raw.githubusercontent.com/Termix-SSH/Termix/main/scripts/authz/authz.schema.json",
  "seed": [
    {
      "as": "owner",
      "method": "POST",
      "path": "/plugin-api/coolify/connections",
      "body": {
        "name": "authz-own-connection",
        "baseUrl": "https://coolify.invalid",
        "token": "authz-fake-token"
      },
      "capture": {
        "coolify.connection": "id"
      }
    }
  ],
  "routes": {
    "GET /plugin-api/coolify/connections": {
      "access": "user",
      "permission": "coolify.view",
      "filtered": true
    },
    "POST /plugin-api/coolify/connections": {
      "access": "user",
      "permission": "coolify.configure",
      "body": {
        "name": "authz-other-connection",
        "baseUrl": "https://coolify.invalid",
        "token": "authz-fake-token"
      }
    },
    "GET /plugin-api/coolify/connections/:id": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      }
    },
    "PATCH /plugin-api/coolify/connections/:id": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      },
      "body": {
        "name": "authz-own-renamed"
      }
    },
    "DELETE /plugin-api/coolify/connections/:id": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      },
      "destructive": true
    },
    "POST /plugin-api/coolify/connections/:id/probe": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      }
    },
    "GET /plugin-api/coolify/connections/:id/servers": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      }
    },
    "POST /plugin-api/coolify/connections/:id/sync": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      },
      "body": {
        "choices": []
      }
    },
    "POST /plugin-api/coolify/connections/:id/servers/:uuid/unlink": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection",
        "uuid": "=authz-own-server"
      },
      "body": {
        "removeHost": false
      },
      "destructive": true
    },
    "GET /plugin-api/coolify/companions": {
      "access": "user",
      "permission": "coolify.view"
    },
    "GET /plugin-api/coolify/connections/:id/resources/:uuid/dns": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection",
        "uuid": "=authz-own-resource"
      },
      "allowed": "any",
      "note": "Answers 404 companion-missing unless the DNS plugin runs, and the authz run installs no companions"
    },
    "POST /plugin-api/coolify/connections/:id/resources/:uuid/dns": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection",
        "uuid": "=authz-own-resource"
      },
      "allowed": "any",
      "note": "Answers 404 companion-missing unless the DNS plugin runs, and the authz run installs no companions",
      "body": {
        "fqdn": "authz-own.example.test",
        "type": "A",
        "content": "203.0.113.10"
      }
    },
    "DELETE /plugin-api/coolify/connections/:id/resources/:uuid/dns/:recordId": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection",
        "uuid": "=authz-own-resource",
        "recordId": "=1"
      },
      "allowed": "any",
      "note": "Answers 404 companion-missing unless the DNS plugin runs, and the authz run installs no companions. Deletes a DNS record, like the destructive action coolify.companion-dns-remove",
      "destructive": true
    },
    "GET /plugin-api/coolify/connections/:id/resources/:uuid/uptime": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
