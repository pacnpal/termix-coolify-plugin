{
  "$schema": "https://raw.githubusercontent.com/Termix-SSH/Termix/main/scripts/authz/authz.schema.json",
  "seed": [
    {
      "as": "owner",
      "method": "POST",
      "path": "/plugin-api/coolify/connections",
      "body": {
        "name": "authz-own-connection",
        "baseUrl": "https://coolify.invalid",
        "token": "authz-fake-token"
      },
      "capture": {
        "coolify.connection": "id"
      }
    }
  ],
  "routes": {
    "GET /plugin-api/coolify/connections": {
      "access": "user",
      "permission": "coolify.view",
      "filtered": true
    },
    "POST /plugin-api/coolify/connections": {
      "access": "user",
      "permission": "coolify.configure",
      "body": {
        "name": "authz-other-connection",
        "baseUrl": "https://coolify.invalid",
        "token": "authz-fake-token"
      }
    },
    "GET /plugin-api/coolify/connections/:id": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      }
    },
    "PATCH /plugin-api/coolify/connections/:id": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      },
      "body": {
        "name": "authz-own-renamed"
      }
    },
    "DELETE /plugin-api/coolify/connections/:id": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      },
      "destructive": true
    },
    "POST /plugin-api/coolify/connections/:id/probe": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      }
    },
    "GET /plugin-api/coolify/connections/:id/servers": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      }
    },
    "POST /plugin-api/coolify/connections/:id/sync": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      },
      "body": {
        "choices": []
      }
    },
    "POST /plugin-api/coolify/connections/:id/servers/:uuid/unlink": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection",
        "uuid": "=authz-own-server"
      },
      "body": {
        "removeHost": false
      },
      "destructive": true
    },
    "GET /plugin-api/coolify/connections/:id/resources": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      },
      "allowed": "any",
      "note": "The seeded connection points at coolify.invalid, so an allowed caller gets 502 from Coolify; there is no reachable Coolify in the authz run."
    },
    "GET /plugin-api/coolify/connections/:id/resources/:uuid": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection",
        "uuid": "=authz-resource-uuid"
      },
      "allowed": "any",
      "note": "The seeded connection points at coolify.invalid, so an allowed caller gets 502 from Coolify; there is no reachable Coolify in the authz run."
    },
    "POST /plugin-api/coolify/connections/:id/resources/:uuid/shell": {
      "access": "user",
      "permission": "coolify.operate",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection",
        "uuid": "=authz-resource-uuid"
      },
      "body": {},
      "allowed": "any",
      "note": "The seeded connection points at coolify.invalid, so an allowed caller gets 502 from Coolify before any SSH; there is no reachable Coolify or Linked host in the authz run."
    },
    "GET /plugin-api/coolify/connections/:id/servers/:uuid/metrics": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection",
        "uuid": "=authz-own-server"
      },
      "allowed": "any",
      "note": "The seeded connection points at coolify.invalid, so an allowed caller gets 502 from Coolify; there is no reachable Coolify in the authz run."
    },
    "POST /plugin-api/coolify/connections/:id/servers/:uuid/metrics/enable": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection",
        "uuid": "=authz-own-server"
      },
      "body": {},
      "destructive": true
    },
    "GET /plugin-api/coolify/connections/:id/resources/:uuid/metrics": {
      "access": "user",
      "permission": "coolify.operate",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection",
        "uuid": "=authzresourceuuid"
      },
      "allowed": "any",
      "note": "The seeded connection points at coolify.invalid, so an allowed caller gets 502 from Coolify before any SSH; there is no reachable Coolify, Linked host or Sentinel in the authz run."
    },
    "GET /plugin-api/coolify/connections/:id/resources/:uuid/traffic": {
      "access": "user",
      "permission": "coolify.operate",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection",
        "uuid": "=authzresourceuuid"
      },
      "allowed": "any",
      "note": "The seeded connection points at coolify.invalid, so an allowed caller gets 502 from Coolify before any SSH; there is no reachable Coolify, Linked host or Sentinel in the authz run."
    },
    "WS /plugin-ws/coolify/stats": {
      "access": "user",
      "permission": "coolify.operate",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "send": [
        {
          "connectionId": "{{coolify.connection}}",
          "uuid": "authzresourceuuid"
        }
      ],
      "refuseReply": "\"type\":\"error\"",
      "refusalCloseCodes": [1008],
      "allowed": "any",
      "note": "The seeded connection points at coolify.invalid, so an allowed caller gets an error reply from Coolify before any SSH; there is no reachable Coolify, Linked host or container in the authz run."
    }
  }
}
