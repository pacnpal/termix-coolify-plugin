{
  "$schema": "https://raw.githubusercontent.com/Termix-SSH/Termix/main/scripts/authz/authz.schema.json",
  "seed": [
    {
      "as": "owner",
      "method": "POST",
      "path": "/plugin-api/coolify/connections",
      "body": {
        "name": "authz-own-connection",
        "baseUrl": "https://coolify.invalid",
        "token": "authz-fake-token"
      },
      "capture": {
        "coolify.connection": "id"
      }
    },
    {
      "as": "owner",
      "method": "POST",
      "path": "/plugin-api/coolify/connections/{{coolify.connection}}/status-pages",
      "body": {
        "title": "authz-own-page",
        "resources": ["authz-resource-uuid"]
      },
      "capture": {
        "coolify.status-page": "id"
      }
    }
  ],
  "routes": {
    "GET /plugin-api/coolify/connections": {
      "access": "user",
      "permission": "coolify.view",
      "filtered": true
    },
    "POST /plugin-api/coolify/connections": {
      "access": "user",
      "permission": "coolify.configure",
      "body": {
        "name": "authz-other-connection",
        "baseUrl": "https://coolify.invalid",
        "token": "authz-fake-token"
      }
    },
    "GET /plugin-api/coolify/connections/:id": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      }
    },
    "PATCH /plugin-api/coolify/connections/:id": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      },
      "body": {
        "name": "authz-own-renamed"
      }
    },
    "DELETE /plugin-api/coolify/connections/:id": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      },
      "destructive": true
    },
    "POST /plugin-api/coolify/connections/:id/probe": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      }
    },
    "GET /plugin-api/coolify/connections/:id/resources": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      },
      "allowed": "any",
      "note": "The seeded connection points at coolify.invalid, so an allowed caller gets 502 from Coolify; there is no reachable Coolify in the authz run."
    },
    "GET /plugin-api/coolify/connections/:id/resources/:uuid": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection",
        "uuid": "=authz-resource-uuid"
      },
      "allowed": "any",
      "note": "The seeded connection points at coolify.invalid, so an allowed caller gets 502 from Coolify; there is no reachable Coolify in the authz run."
    },
    "POST /plugin-api/coolify/mcp": {
      "access": "user",
      "permission": "coolify.mcp",
      "body": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "ping"
      }
    },
    "GET /plugin-api/coolify/mcp": {
      "access": "user",
      "permission": "coolify.mcp"
    },
    "GET /plugin-api/coolify/connections/:id/status-pages": {
      "access": "user",
      "permission": "coolify.view",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      }
    },
    "POST /plugin-api/coolify/connections/:id/status-pages": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.connection"
      },
      "params": {
        "id": "coolify.connection"
      },
      "body": {
        "title": "authz-other-page",
        "resources": ["authz-resource-uuid"]
      }
    },
    "POST /plugin-api/coolify/status-pages/:id/rotate": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.status-page"
      },
      "params": {
        "id": "coolify.status-page"
      },
      "destructive": true
    },
    "DELETE /plugin-api/coolify/status-pages/:id": {
      "access": "user",
      "permission": "coolify.configure",
      "resource": {
        "kind": "own",
        "fixture": "coolify.status-page"
      },
      "params": {
        "id": "coolify.status-page"
      },
      "destructive": true
    },
    "POST /plugin-api/coolify/status-pages/handoff/:handoffId": {
      "access": "user",
      "permission": "coolify.configure",
      "params": {
        "handoffId": "=authz-handoff-none"
      },
      "expect": {
        "key-ops-read": "refuse",
        "key-ops-run": "refuse"
      },
      "allowed": "any",
      "note": "Needs a session or an unscoped key: core refuses keys scoped to operations on every plugin route but /mcp, and those keys take the URL with the MCP tool take_status_page_url. Nothing waits to be handed over in the authz run, so an allowed caller gets 404."
    },
    "GET /plugin-api/coolify/status/:token": {
      "access": "public",
      "params": {
        "token": "=authz-unknown-token-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "allowed": "any",
      "note": "No login. A real token is shown once and only inside a URL, so the run can't use one; every caller gets the same 404 for this unknown token."
    },
    "GET /plugin-api/coolify/status/:token.json": {
      "access": "public",
      "params": {
        "token": "=authz-unknown-token-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "allowed": "any",
      "note": "No login. A real token is shown once and only inside a URL, so the run can't use one; every caller gets the same 404 for this unknown token."
    }
  }
}
