{
  "id": "coolify",
  "name": "Coolify for Termix",
  "version": "1.0.0",
  "description": "Coolify inside Termix: servers become hosts (tunnels included), one-click container shells, deploys, logs, variables, backups and alerts, and the full Coolify API.",
  "author": {
    "name": "pacnpal",
    "url": "https://github.com/pacnpal"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/pacnpal/termix-coolify-plugin",
  "docs": "https://github.com/pacnpal/termix-coolify-plugin/tree/main/docs",
  "category": "Infrastructure",
  "icon": "Rocket",
  "features": [
    "Connect one or more Coolify instances with an API token",
    "Coolify servers become locked Termix hosts, Cloudflare tunnels included",
    "One-click shells and database consoles in any Coolify container",
    "Start, stop, restart and deploy applications, services and databases",
    "Server metrics, traffic and package updates",
    "Public read-only status pages",
    "Every Coolify API operation from Termix's API, CLI and MCP"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.11.2-0",
    "api": "^2.7.0"
  },
  "capabilities": [
    "db:own",
    "secrets:own",
    "kv:own",
    "network:serve",
    "network:outbound",
    "ui:surface",
    "hosts:read",
    "hosts:write",
    "hosts:lock",
    "credentials:write",
    "credentials:use",
    "ssh:connect",
    "operations:provide",
    "notify:send",
    "events:core",
    "plugins:read",
    "users:read",
    "operations:invoke"
  ],
  "optionalDependencies": {
    "ssh-terminal": "^1.0.0",
    "docker": "^1.0.0",
    "homepage": "^1.0.0",
    "file-manager": "^1.0.0",
    "tunnels": "^1.0.0",
    "dns": "^1.0.0",
    "reverse-proxy": "^1.0.0",
    "security-center": "^1.0.0",
    "uptime": "^1.0.0",
    "log-search": "^1.0.0",
    "package-manager": "^1.0.0",
    "host-metrics": "^1.0.0",
    "databases": "^1.0.0",
    "backups": "^1.0.0",
    "automations": "^1.0.0",
    "operations-center": "^1.0.0",
    "alerts": "^1.0.0"
  },
  "sandbox": {
    "schedules": [],
    "events": ["host.deleted", "host.updated"]
  },
  "contributes": {
    "tabs": [
      {
        "id": "coolify",
        "titleKey": "tab.title",
        "icon": "Rocket",
        "openFrom": ["rail", "palette"]
      },
      {
        "id": "coolify-shell",
        "titleKey": "shellTab.title",
        "icon": "SquareTerminal",
        "openFrom": ["palette"]
      }
    ],
    "uses": ["terminal.view"],
    "hostSections": [
      {
        "id": "coolify",
        "titleKey": "hostSection.title",
        "icon": "Rocket"
      }
    ],
    "permissions": [
      {
        "name": "view",
        "titleKey": "permissions.view.title",
        "descriptionKey": "permissions.view.description",
        "defaultRoles": ["admin", "user"]
      },
      {
        "name": "operate",
        "titleKey": "permissions.operate.title",
        "descriptionKey": "permissions.operate.description",
        "defaultRoles": ["admin", "user"]
      },
      {
        "name": "configure",
        "titleKey": "permissions.configure.title",
        "descriptionKey": "permissions.configure.description",
        "defaultRoles": ["admin", "user"]
      },
      {
        "name": "administer",
        "titleKey": "permissions.administer.title",
        "descriptionKey": "permissions.administer.description",
        "defaultRoles": ["admin", "user"]
      },
      {
        "name": "mcp",
        "titleKey": "permissions.mcp.title",
        "descriptionKey": "permissions.mcp.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "admin": [
        {
          "key": "allowPolling",
          "type": "boolean",
          "labelKey": "settings.admin.allowPolling.label",
          "descriptionKey": "settings.admin.allowPolling.description",
          "default": true
        },
        {
          "key": "minPollSeconds",
          "type": "number",
          "labelKey": "settings.admin.minPollSeconds.label",
          "descriptionKey": "settings.admin.minPollSeconds.description",
          "default": 60,
          "min": 30,
          "max": 86400,
          "requires": "allowPolling"
        },
        {
          "key": "allowKeyCopy",
          "type": "boolean",
          "labelKey": "settings.admin.allowKeyCopy.label",
          "descriptionKey": "settings.admin.allowKeyCopy.description",
          "default": true
        },
        {
          "key": "allowSharing",
          "type": "boolean",
          "labelKey": "settings.admin.allowSharing.label",
          "descriptionKey": "settings.admin.allowSharing.description",
          "default": true
        },
        {
          "key": "allowProvisioning",
          "type": "boolean",
          "labelKey": "settings.admin.allowProvisioning.label",
          "descriptionKey": "settings.admin.allowProvisioning.description",
          "default": true
        },
        {
          "key": "allowStatusPages",
          "type": "boolean",
          "labelKey": "settings.admin.allowStatusPages.label",
          "descriptionKey": "settings.admin.allowStatusPages.description",
          "default": true
        },
        {
          "key": "allowMcpChanges",
          "type": "boolean",
          "labelKey": "settings.admin.allowMcpChanges.label",
          "descriptionKey": "settings.admin.allowMcpChanges.description",
          "default": false
        },
        {
          "key": "allowExec",
          "type": "boolean",
          "labelKey": "settings.admin.allowExec.label",
          "descriptionKey": "settings.admin.allowExec.description",
          "default": false
        }
      ],
      "host": {
        "enableKey": "coolifyLinked",
        "enableLabelKey": "settings.host.coolifyLinked.label",
        "enableDescriptionKey": "settings.host.coolifyLinked.description",
        "fields": [
          {
            "key": "coolifyConnectionId",
            "type": "string",
            "labelKey": "settings.host.coolifyConnectionId.label",
            "hidden": true,
            "defaultable": false
          },
          {
            "key": "coolifyServerUuid",
            "type": "string",
            "labelKey": "settings.host.coolifyServerUuid.label",
            "hidden": true,
            "defaultable": false
          }
        ]
      }
    },
    "operations": {
      "actions": [
        {
          "id": "coolify.list-connections",
          "titleKey": "ops.listConnections.title",
          "descriptionKey": "ops.listConnections.description",
          "icon": "Rocket",
          "scope": "server",
          "risk": "read",
          "permission": "view",
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "coolify.connection-probe",
          "titleKey": "ops.connectionProbe.title",
          "descriptionKey": "ops.connectionProbe.description",
          "icon": "Stethoscope",
          "scope": "server",
          "inputs": [
            {
              "key": "connectionId",
              "type": "select",
              "labelKey": "ops.fields.connectionId.label",
              "descriptionKey": "ops.fields.connectionId.description",
              "optionsFrom": "coolify.list-connections",
              "required": true
            }
          ],
          "risk": "read",
          "permission": "view",
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "coolify.connection-create",
          "titleKey": "ops.connectionCreate.title",
          "descriptionKey": "ops.connectionCreate.description",
          "icon": "Plus",
          "scope": "server",
          "inputs": [
            {
              "key": "name",
              "type": "string",
              "labelKey": "ops.fields.name.label",
              "required": true
            },
            {
              "key": "baseUrl",
              "type": "string",
              "labelKey": "ops.fields.baseUrl.label",
              "descriptionKey": "ops.fields.baseUrl.description",
              "required": true
            },
            {
              "key": "token",
              "type": "secret",
              "labelKey": "ops.fields.token.label",
              "descriptionKey": "ops.fields.token.description",
              "required": true
            },
            {
              "key": "cfAccessId",
              "type": "secret",
              "labelKey": "ops.fields.cfAccessId.label",
              "group": "advanced"
            },
            {
              "key": "cfAccessSecret",
              "type": "secret",
              "labelKey": "ops.fields.cfAccessSecret.label",
              "group": "advanced"
            },
            {
              "key": "allowPrivate",
              "type": "boolean",
              "labelKey": "ops.fields.allowPrivate.label",
              "descriptionKey": "ops.fields.allowPrivate.description",
              "group": "advanced"
            },
            {
              "key": "caCert",
              "type": "textarea",
              "labelKey": "ops.fields.caCert.label",
              "descriptionKey": "ops.fields.caCert.description",
              "group": "advanced"
            }
          ],
          "risk": "change",
          "permission": "configure",
          "surfaces": {
            "assistant": false,
            "mcp": false
          }
        },
        {
          "id": "coolify.connection-update",
          "titleKey": "ops.connectionUpdate.title",
          "descriptionKey": "ops.connectionUpdate.description",
          "icon": "Pencil",
          "scope": "server",
          "inputs": [
            {
              "key": "connectionId",
              "type": "select",
              "labelKey": "ops.fields.connectionId.label",
              "descriptionKey": "ops.fields.connectionId.description",
              "optionsFrom": "coolify.list-connections",
              "required": true
            },
            {
              "key": "name",
              "type": "string",
              "labelKey": "ops.fields.name.label"
            },
            {
              "key": "baseUrl",
              "type": "string",
              "labelKey": "ops.fields.baseUrl.label",
              "descriptionKey": "ops.fields.baseUrl.description"
            },
            {
              "key": "token",
              "type": "secret",
              "labelKey": "ops.fields.token.label",
              "descriptionKey": "ops.fields.token.keepDescription"
            },
            {
              "key": "cfAccessId",
              "type": "secret",
              "labelKey": "ops.fields.cfAccessId.label",
              "group": "advanced"
            },
            {
              "key": "cfAccessSecret",
              "type": "secret",
              "labelKey": "ops.fields.cfAccessSecret.label",
              "group": "advanced"
            },
            {
              "key": "allowPrivate",
              "type": "boolean",
              "labelKey": "ops.fields.allowPrivate.label",
              "descriptionKey": "ops.fields.allowPrivate.description",
              "group": "advanced"
            },
            {
              "key": "caCert",
              "type": "textarea",
              "labelKey": "ops.fields.caCert.label",
              "descriptionKey": "ops.fields.caCert.description",
              "group": "advanced"
            },
            {
              "key": "autoSync",
              "type": "boolean",
              "labelKey": "ops.fields.autoSync.label"
            }
          ],
          "risk": "change",
          "permission": "configure",
          "surfaces": {
            "assistant": false,
            "mcp": false
          }
        },
        {
          "id": "coolify.connection-delete",
          "titleKey": "ops.connectionDelete.title",
          "descriptionKey": "ops.connectionDelete.description",
          "icon": "Trash2",
          "scope": "server",
          "inputs": [
            {
              "key": "connectionId",
              "type": "select",
              "labelKey": "ops.fields.connectionId.label",
              "descriptionKey": "ops.fields.connectionId.description",
              "optionsFrom": "coolify.list-connections",
              "required": true
            },
            {
              "key": "removeHosts",
              "type": "boolean",
              "labelKey": "ops.fields.removeHosts.label",
              "descriptionKey": "ops.fields.removeHosts.description",
              "default": false
            }
          ],
          "risk": "destructive",
          "permission": "configure",
          "surfaces": {
            "assistant": false,
            "mcp": false
          }
        },
        {
          "id": "coolify.connection-set-exec",
          "titleKey": "ops.connectionSetExec.title",
          "descriptionKey": "ops.connectionSetExec.description",
          "icon": "ShieldAlert",
          "scope": "server",
          "inputs": [
            {
              "key": "connectionId",
              "type": "select",
              "labelKey": "ops.fields.connectionId.label",
              "descriptionKey": "ops.fields.connectionId.description",
              "optionsFrom": "coolify.list-connections",
              "required": true
            },
            {
              "key": "execEnabled",
              "type": "boolean",
              "labelKey": "ops.fields.execEnabled.label",
              "descriptionKey": "ops.fields.execEnabled.description",
              "required": true
            }
          ],
          "risk": "change",
          "permission": "configure",
          "surfaces": {
            "assistant": false,
            "mcp": false
          }
        },
        {
          "id": "coolify.sync-preview",
          "titleKey": "ops.syncPreview.title",
          "descriptionKey": "ops.syncPreview.description",
          "icon": "RefreshCw",
          "scope": "server",
          "inputs": [
            {
              "key": "connectionId",
              "type": "select",
              "labelKey": "ops.fields.connectionId.label",
              "descriptionKey": "ops.fields.connectionId.description",
              "optionsFrom": "coolify.list-connections",
              "required": true
            }
          ],
          "risk": "read",
          "permission": "view",
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "coolify.sync-apply",
          "titleKey": "ops.syncApply.title",
          "descriptionKey": "ops.syncApply.description",
          "icon": "RefreshCw",
          "scope": "server",
          "inputs": [
            {
              "key": "connectionId",
              "type": "select",
              "labelKey": "ops.fields.connectionId.label",
              "descriptionKey": "ops.fields.connectionId.description",
              "optionsFrom": "coolify.list-connections",
              "required": true
            },
            {
              "key": "choices",
              "type": "json",
              "labelKey": "ops.fields.choices.label",
              "descriptionKey": "ops.fields.choices.description"
            }
          ],
          "risk": "change",
          "permission": "configure",
          "check": "coolify.sync-preview",
          "surfaces": {
            "assistant": false,
            "mcp": false
          }
        },
        {
          "id": "coolify.unlink",
          "titleKey": "ops.unlink.title",
          "descriptionKey": "ops.unlink.description",
          "icon": "Unlink",
          "scope": "server",
          "inputs": [
            {
              "key": "connectionId",
              "type": "select",
              "labelKey": "ops.fields.connectionId.label",
              "descriptionKey": "ops.fields.connectionId.description",
              "optionsFrom": "coolify.list-connections",
              "required": true
            },
            {
              "key": "serverUuid",
              "type": "string",
              "labelKey": "ops.fields.serverUuid.label",
              "descriptionKey": "ops.fields.serverUuid.description",
              "pattern": "[A-Za-z0-9_-]{1,64}",
              "required": true
            }
          ],
          "risk": "change",
          "permission": "configure",
          "surfaces": {
            "assistant": false,
            "mcp": false
          }
        },
        {
          "id": "coolify.list-resources-all",
          "titleKey": "ops.listResourcesAll.title",
          "descriptionKey": "ops.listResourcesAll.description",
          "icon": "Boxes",
          "scope": "server",
          "inputs": [
            {
              "key": "connectionId",
              "type": "select",
              "labelKey": "ops.fields.connectionId.label",
              "descriptionKey": "ops.fields.connectionId.description",
              "optionsFrom": "coolify.list-connections",
              "required": true
            },
            {
              "key": "serverUuid",
              "type": "string",
              "labelKey": "ops.fields.serverFilter.label",
              "descriptionKey": "ops.fields.serverFilter.description"
            }
          ],
          "risk": "read",
          "permission": "view",
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "coolify.resource-get",
          "titleKey": "ops.resourceGet.title",
          "descriptionKey": "ops.resourceGet.description",
          "icon": "Box",
          "scope": "server",
          "inputs": [
            {
              "key": "connectionId",
              "type": "select",
              "labelKey": "ops.fields.connectionId.label",
              "descriptionKey": "ops.fields.connectionId.description",
              "optionsFrom": "coolify.list-connections",
              "required": true
            },
            {
              "key": "uuid",
              "type": "string",
              "labelKey": "ops.fields.uuid.label",
              "descriptionKey": "ops.fields.uuid.description",
              "required": true
            }
          ],
          "risk": "read",
          "permission": "view",
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "coolify.shell-command",
          "titleKey": "ops.shellCommand.title",
          "descriptionKey": "ops.shellCommand.description",
          "icon": "SquareTerminal",
          "scope": "server",
          "inputs": [
            {
              "key": "connectionId",
              "type": "select",
              "labelKey": "ops.fields.connectionId.label",
              "descriptionKey": "ops.fields.connectionId.description",
              "optionsFrom": "coolify.list-connections",
              "required": true
            },
            {
              "key": "uuid",
              "type": "string",
              "labelKey": "ops.fields.uuid.label",
              "descriptionKey": "ops.fields.uuid.description",
              "pattern": "[A-Za-z0-9_-]{1,64}",
              "required": true
            },
            {
              "key": "part",
              "type": "string",
              "labelKey": "ops.fields.part.label",
              "descriptionKey": "ops.fields.part.description",
              "pattern": "[A-Za-z0-9_-]{1,64}"
            },
            {
              "key": "container",
              "type": "string",
              "labelKey": "ops.fields.container.label",
              "descriptionKey": "ops.fields.container.description",
              "pattern": "[A-Za-z0-9_.-]{1,255}"
            },
            {
              "key": "console",
              "type": "select",
              "labelKey": "ops.fields.console.label",
              "descriptionKey": "ops.fields.console.description",
              "options": [
                {
                  "value": "shell",
                  "labelKey": "ops.fields.console.shell"
                },
                {
                  "value": "db",
                  "labelKey": "ops.fields.console.db"
                }
              ],
              "default": "shell"
            }
          ],
          "risk": "read",
          "permission": "operate",
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "coolify.exec",
          "titleKey": "ops.exec.title",
          "descriptionKey": "ops.exec.description",
          "icon": "SquareTerminal",
          "scope": "server",
          "inputs": [
            {
              "key": "connectionId",
              "type": "select",
              "labelKey": "ops.fields.connectionId.label",
              "descriptionKey": "ops.fields.connectionId.description",
              "optionsFrom": "coolify.list-connections",
              "required": true
            },
            {
              "key": "uuid",
              "type": "string",
              "labelKey": "ops.fields.uuid.label",
              "descriptionKey": "ops.fields.uuid.description",
              "pattern": "[A-Za-z0-9_-]{1,64}",
              "required": true
            },
            {
              "key": "part",
              "type": "string",
              "labelKey": "ops.fields.part.label",
              "descriptionKey": "ops.fields.part.description",
              "pattern": "[A-Za-z0-9_-]{1,64}"
            },
            {
              "key": "container",
              "type": "string",
              "labelKey": "ops.fields.container.label",
              "descriptionKey": "ops.fields.container.description",
              "pattern": "[A-Za-z0-9_.-]{1,255}"
            },
            {
              "key": "command",
              "type": "string",
              "labelKey": "ops.fields.command.label",
              "descriptionKey": "ops.fields.command.description",
              "required": true
            },
            {
              "key": "timeoutSec",
              "type": "number",
              "labelKey": "ops.fields.timeoutSec.label",
              "descriptionKey": "ops.fields.timeoutSec.description",
              "min": 1,
              "max": 120,
              "default": 30
            }
          ],
          "risk": "destructive",
          "permission": "operate",
          "timeoutMs": 150000,
          "surfaces": {
            "assistant": false,
            "mcp": false
          }
        }
      ]
    },
    "mobile": {
      "mode": "webview",
      "views": ["coolify", "coolify-shell"]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
